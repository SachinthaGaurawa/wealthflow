rules_version = '2';

// =============================================================================
//  WealthFlow - Firestore Security Rules
//  ---------------------------------------------------------------------------
//  WHY THIS FILE EXISTS
//  Firestore rules - not application code - are what actually stop one signed-in
//  user from reading another user's data. The app stores each user's financial
//  data under users/{uid} and AI memory under userAI/{uid}, which is correct.
//  But until these rules are DEPLOYED, the database is in whatever state the
//  console left it (typically test mode: open). A committed rules file protects
//  nothing; only `firebase deploy --only firestore:rules` does.
//
//  This rule set was written against the ACTUAL Firestore paths the code uses,
//  verified by a full census of every .collection() call in the browser bundle
//  and every REST path in the serverless functions. Nothing the app touches
//  falls through to the default-deny rule at the bottom.
//
//    users/{uid}/**                   private financial data      client SDK
//    users/{uid}/shared_stmts/{id}    legacy ?ustmt= share links  client SDK (read-only)
//    userAI/{uid}/**                  private AI memory           client SDK
//    feedback/{id}                    feedback reports            client SDK
//    system/{doc}                     manifest/pendingRelease/…   client read, Admin write
//    s/{id}, shared_statements/{id}   public SHARE payloads       client SDK + REST
//    shared_stmts/{id}, links/{id}    legacy public SHARE maps    read-only
//    wf-inbox/**                      SMS bridge relay            Admin SDK only - SEALED
//    wf-mail/**                       Gmail statement pipeline    Admin SDK only - SEALED
//
//  HOW SERVER ACCESS WORKS (this is what makes the sealed branches possible):
//   • release-brain.js, approve-release.js, health.js and inbox-store.mjs use
//     the Firebase Admin SDK (service account) -> they BYPASS these rules
//     entirely. That is why system/* and wf-inbox/** can be write:false here
//     while the server still writes them.
//   • statement-view.js still calls the Firestore REST API with only the public
//     Web API key -> those requests are UNAUTHENTICATED (request.auth == null).
//     It only READS a share and bumps a view counter, which is why get stays
//     public and update is pinned to that counter. statement-store.js no longer
//     uses REST at all: every share write and delete goes through the Admin SDK,
//     which is what allows create and delete to be sealed below.
//
//  DEPLOY:  firebase deploy --only firestore:rules
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Admin is a Firebase Auth CUSTOM CLAIM, not a uid pasted into this file.
    // Nobody has it until it is granted deliberately, and it evaluates false
    // for every account until then - so this is closed by default with no
    // placeholder to forget. To grant it (once, from a trusted machine with the
    // service account available):
    //
    //   node -e "const a=require('firebase-admin');a.initializeApp({credential:a.credential.cert(JSON.parse(process.env.FIREBASE_SERVICE_ACCOUNT))});a.auth().setCustomUserClaims('<UID>',{admin:true}).then(()=>console.log('ok'))"
    //
    // To revoke, set {admin:false}. Revoking takes effect on the user's next
    // token refresh (<=1h) - unlike a uid list, no rules redeploy is needed.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // True when a write changes NOTHING except the named fields. Used to let an
    // unauthenticated view-counter increment a share doc without letting anyone
    // rewrite the statement a recipient is about to read.
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // === 1. PRIVATE USER DATA - owner only ==================================
    //  THE data-isolation rule: a user can read/write only their own document
    //  and its subcollections. No one can read anyone else's.
    match /users/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // --- 1b. LEGACY ?ustmt= SHARE LINKS (narrow, deliberate exception) ------
    //  Old builds minted share links of the form ?ustmt=UID_DOCID, which resolve
    //  by reading users/{uid}/shared_stmts/{docId} - a document the owner
    //  explicitly chose to share, that happens to live inside the private tree.
    //  NOTHING in the current codebase writes this path any more; index.html
    //  only reads it, so this exists purely so links already in circulation keep
    //  working.
    //
    //  `get` not `read`: a single-document fetch is allowed (that is all a share
    //  link does), but `list` is denied, so holding one legacy link does NOT let
    //  anyone enumerate that user's other shared statements.
    //
    //  Safe to delete these four lines if you do not care about legacy links -
    //  rule 1 above then denies the path outright.
    match /users/{uid}/shared_stmts/{docId} {
      allow get: if true;
      allow list, write: if isOwner(uid);
    }

    // === 2. PER-USER AI MEMORY - owner only =================================
    match /userAI/{uid}/{document=**} {
      allow read, write: if isOwner(uid);
    }

    // === 3. FEEDBACK - create your own, read only your own (+ admins) =======
    //  • A signed-in user may create feedback tagged with their own uid.
    //  • Signed-out submissions are allowed only when tagged uid == 'anon'
    //    (matches the app's offline/sign-out behaviour).
    //  • A user can read only their OWN feedback. The app's own query is
    //    .where('uid','==',myUid), which satisfies this; a broad "list all
    //    feedback" query is refused unless the requester holds the admin claim.
    //  • Feedback is append-only from clients. release-brain.js archives and
    //    prunes it via the Admin SDK, which bypasses these rules.
    match /feedback/{docId} {
      allow read: if isAdmin()
                  || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 5000
                    && (
                         (signedIn() && request.resource.data.uid == request.auth.uid)
                         || request.resource.data.uid == 'anon'
                       );
      allow update, delete: if false;
    }

    // === 4. SYSTEM DOCS - public read, no client writes =====================
    //  manifest / pendingRelease / feedbackPriority / releaseHistory are read by
    //  the app to show the update pill and the feedback board. They are written
    //  ONLY by release-brain.js and approve-release.js via the Admin SDK (which
    //  bypasses these rules), so client writes are denied.
    match /system/{doc} {
      allow read: if true;
      allow write: if false;
    }

    // === 5. PUBLIC SHARE LINKS - readable by anyone holding the link ========
    //  These hold content the user explicitly chose to SHARE. Share links are
    //  opened without signing in, so reads must be public.
    //
    //  FOUR THINGS ARE DELIBERATELY NARROWED HERE vs. a plain `if true`:
    //
    //  1. `get` not `read`. `read` is `get` + `list`. Every reader in the
    //     codebase fetches ONE document by id (index.html ?s=/?stmt=/?go=
    //     handlers, statement-view.js REST GET); nothing queries a collection.
    //     Granting list therefore buys nothing, so it is denied.
    //
    //  2. Updates are pinned to the view counter. The update permission here
    //     exists for exactly one caller: statement-view.js increments s/{id}.v
    //     and shared_statements/{id}.views over unauthenticated REST. A blanket
    //     update would also cover the payload field, which is not something an
    //     anonymous counter should reach. onlyChanges() permits the counter and
    //     nothing else.
    //
    //  3. links/ is write-sealed. Nothing in the codebase writes it (index.html
    //     only reads it for the ?go= redirect), so existing short links keep
    //     resolving while no new ones can be injected.
    //
    //  4. create is SEALED. That HARDENING TODO is now done: statement-store.js
    //     writes through the Admin SDK (admin-db.mjs), and index.html's
    //     client-side fallback that wrote s/ directly is deleted, so no browser
    //     and no unauthenticated REST call mints a share document any more. The
    //     server bypasses these rules, exactly as release-brain.js does for
    //     system/*, so sealing create costs the app nothing.
    //
    //  delete stays `if false` and revocation still works, for the same reason:
    //  the Admin SDK is not subject to these rules. Reopening delete would let
    //  anyone holding a link destroy someone else's shared statement.
    match /shared_statements/{id} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if false;
      allow update: if onlyChanges(['views']);
    }
    match /shared_stmts/{id} {            // legacy top-level map - read-only
      allow get: if true;
      allow list, write: if false;
    }
    match /s/{shortId} {                  // short-code -> statement (Admin SDK writes only)
      allow get: if true;
      allow list: if false;
      allow create, delete: if false;
      allow update: if onlyChanges(['v']);
    }
    match /links/{goId} {                 // short-link redirect map - no writers remain
      allow get: if true;
      allow list, write: if false;
    }

    // === 6. SMS INBOX BRIDGE - SEALED =======================================
    //  This branch holds classified bank transactions, and the app applies
    //  whatever it finds here straight into the user's ledger. It was previously
    //  open to clients because inbox-push/pull/ack reached Firestore over the REST
    //  API with only the public Web apiKey - unauthenticated as far as these rules
    //  are concerned.
    //
    //  The HARDENING TODO that used to sit here is DONE: inbox-push.js,
    //  inbox-pull.js and inbox-ack.js now go through the Firebase Admin SDK
    //  (inbox-store.mjs), which authenticates with the service account and
    //  BYPASSES these rules entirely - the same mechanism release-brain.js uses to
    //  write system/* while that collection is `allow write: if false`.
    //
    //  So this branch is closed completely. No client, signed in or not, has any
    //  business reading or writing another device's bank alerts; the only
    //  legitimate accessor is the server, and the server does not consult rules.
    //
    //  The per-device boundary now lives entirely in inbox-store.mjs
    //  (deviceTokenFrom + itemIdFrom): the server derives the bucket from the
    //  presented token and refuses any key naming a different one. Firestore no
    //  longer gets a vote, which is why those checks are covered by
    //  test/api_runtime_contract_test.js and the file is under the sensitive-path
    //  gate.
    match /wf-inbox/{deviceHash}/{document=**} {
      allow read, write: if false;
    }

    // === 6b. wf-mail - Gmail statement pipeline ============================
    //  SEALED, exactly like wf-inbox above, and for a stronger reason: this
    //  branch holds a Google REFRESH TOKEN, a credential that can read the
    //  owner's entire mailbox for as long as it is not revoked.
    //
    //  It was already sealed before this block existed, by the default-deny at
    //  the end of this file. Writing it out changes no behaviour; it makes the
    //  sealing DELIBERATE rather than incidental, so that adding a wf-mail rule
    //  later is a decision somebody has to make on purpose.
    //
    //  IT ALSO SEALS READS, AND THAT MATTERED. The Statement Sync card first
    //  shipped querying this branch straight from the browser to ask whether a
    //  mailbox was connected. Every one of those calls was denied, caught, and
    //  reported as "not connected" — the card would have said that with a
    //  mailbox perfectly connected, because it could never see the answer.
    //
    //  Both directions now go through /api/gmail-link, which uses the Admin SDK
    //  and bypasses these rules. That makes gmail-link.mjs's identify() the
    //  whole boundary: the document key is derived from a VERIFIED email on a
    //  Firebase ID token and from nothing the caller sends. Firestore no longer
    //  gets a vote, which is why those checks are covered by
    //  test/gmail_link_test.js and the file is under the sensitive-path gate.
    match /wf-mail/{userKey}/{document=**} {
      allow read, write: if false;
    }

    // === 7. DEFAULT - deny everything not explicitly allowed above ==========
    //  Also covers feedbackArchive/, which release-brain.js writes via the Admin
    //  SDK and no client ever touches.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
