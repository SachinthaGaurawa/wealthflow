/*
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/__/auth/*
  Cache-Control: private, no-store, max-age=0, must-revalidate
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/__/firebase/*
  Cache-Control: private, no-store, max-age=0, must-revalidate
